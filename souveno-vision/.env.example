# Souveno Vision Intelligence — environment variables (copy to .env, never commit .env)
# Camera credentials live ONLY here or in the dashboard's runtime input. They are never written to SQLite or logs.

# --- RTSP camera / NVR channel -------------------------------------------------
# Full URL without credentials (recommended) plus separate username/password:
SOUVENO_RTSP_URL=rtsp://192.168.1.50:554/Streaming/Channels/101
SOUVENO_RTSP_SUBSTREAM_URL=rtsp://192.168.1.50:554/Streaming/Channels/102
SOUVENO_RTSP_USERNAME=viewer
SOUVENO_RTSP_PASSWORD=change-me
# A URL that already embeds credentials is also accepted; it is masked before it reaches any log.

# --- Optional overrides (SOUVENO_<SECTION>__<KEY>, see config/default.yaml) ----
# SOUVENO_APP__PORT=8501
# SOUVENO_MODEL__DEVICE=cpu
# SOUVENO_MODEL__CONFIDENCE=0.45
# SOUVENO_PROCESSING__ANALYTICS_FPS=6
# SOUVENO_SOURCE__TYPE=webcam
# SOUVENO_SOURCE__WEBCAM_INDEX=0

# --- Optional webhook (disabled unless SOUVENO_WEBHOOK__ENABLED=true) ----------
# SOUVENO_WEBHOOK__ENABLED=true
# SOUVENO_WEBHOOK__URL=http://localhost:5678/webhook/souveno
# SOUVENO_WEBHOOK_AUTH=Bearer replace-me

# --- Legacy café demo (unchanged, see README section "Legacy café demo") ------
# USE_GPU=auto
# DEMO_MODE=true
